APP_NAME=Contactur
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

APP_LOCALE=es
# El fallback queda en inglés porque solo se traducen los archivos de lang/es
# que el producto usa; cualquier clave no traducida degrada al texto del framework.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

AUTH_GUARD=api

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=contactur
DB_USERNAME=contactur
DB_PASSWORD=contactur_local_only
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=contactur-local
REVERB_APP_KEY=contactur-local-key
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_BLOCK_FOR=1
CACHE_STORE=redis
CACHE_PREFIX=contactur_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@contactur.test
MAIL_FROM_NAME="${APP_NAME}"
# T19/R23: destino del formulario público de contacto (Mailpit en local).
SUPPORT_EMAIL=soporte@contactur.test
SUPPORT_INQUIRY_RATE_LIMIT_HOURLY=5
SUPPORT_INQUIRY_RATE_LIMIT_DAILY=20
# Proxies cuyo X-Forwarded-For se acepta; vacío = ninguno (default). En producción,
# solo la IP exacta del BFF y junto con BFF_CLIENT_IP_HEADER del frontend.
TRUSTED_PROXIES=
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_EMAIL_RATE_LIMIT=5
NOTIFICATION_EMAIL_REDISPATCH_MINUTES=10

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

CONTACT_REQUEST_EXPIRATION_HOURS=168
CONTACT_REQUEST_RESEND_COOLDOWN_HOURS=168
ACCESS_DRIVER=manual

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=contactur-api
EMAIL_VERIFICATION_TTL=1440
PASSWORD_RESET_TTL=60
EMAIL_CHANGE_TTL=60
AUTH_LOGIN_RATE_LIMIT=5
AUTH_RECOVERY_RATE_LIMIT=3
AUTH_RESEND_RATE_LIMIT=3

DOCUMENT_UPLOAD_MAX_BYTES=10485760
MEDIA_UPLOAD_MAX_BYTES=5242880
MEDIA_UPLOAD_MAX_WIDTH=6000
MEDIA_UPLOAD_MAX_HEIGHT=6000
GALLERY_MAX_ITEMS=20
